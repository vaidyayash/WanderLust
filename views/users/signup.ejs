<% layout("layouts/boilerPlate") %>
<body>
  <div class="row mt-3">
    <div class="col-6 offset-3">
      <br>
      <h1>User Signup</h1>
      <br>
      <form action="/signup" method="POST" novalidate class="needs-validation">
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input 
          id="username"
          name="username"
          placeholder="Enter Username"
          class="form-control"
          required
          type="text">
          <div class="valid-feedback">Valid Input</div>
          <div class="invalid-feedback">Invalid Title</div>
        </div>
        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input 
          id="email"
          name="email"
          placeholder="Enter Email"
          class="form-control"
          required
          type="email">
          <div class="valid-feedback">Valid Input</div>
          <div class="invalid-feedback">Invalid Title</div>
        </div>
        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input 
          id="password"
          name="password"
          placeholder="Enter Password"
          class="form-control"
          required
          type="password">
          <div class="valid-feedback">Valid Input</div>
          <div class="invalid-feedback">Invalid Title</div>
        </div>
        <br>
        <button class="btn btn-dark">Register</button>
      </form>
    </div>
  </div>
</body>
