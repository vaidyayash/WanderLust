<% layout("/layouts/boilerPlate") %>
<body>
  <div class="row mt-3">
    <div class="col-8 offset-2">
      <h3><%= listing.title %></h3>

      <div class="card listing-card col-6">
        <img
          src="<%=listing.image.url%>"
          class="card-img-top show-img"
          alt="listing_image"
        />
        <div class="card-body">
          <br>
          <p> Owned by <b><i><%= listing.owner.username %></i></b></p>
          <p class="description fs-6"><%= listing.description %></p>
          <p class="fs-6">
            <b>&#163;<%= Number(listing.price).toLocaleString("en-GB") %></b>
          </p>
          <p class="fs-6">
            <b><%= listing.location %>, &nbsp;<%= listing.country %></b>
          </p>
        </div>
      </div>
    </div>
  </div>  <div class="btns offset-2">
    <div class="col-2 mb-4">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark"
        >Edit Listing</a
      >
    </div>
    <div class="col-2 mb-4">
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark">Delete Listing</button>
      </form>
    </div>
  </div>


  <div class="col-8 offset-2 mt-4 mb-4 review">
    <h4>Leave a Review</h4>
    <form method="POST" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
      <div>
        <label class="form-label" for="rating">Rating</label>
        <input id="rating" name="review[rating]" class="form-range" type="range" min="1" max="5" step="1" required>
        <div class="invalid-feedback">Rating is required.</div>
      </div>
      <div>
        <label class="form-label" for="comment">Comment</label>
        <br>
        <textarea class="form-control" id="comment" name="review[comment]" maxlength="200"></textarea>
      </div>
      <br>
      <button class="btn btn-dark">Submit</button>
    </form>
  </div>
  <div class="reviews col-8 offset-2">
    <hr>
    <p><b>All Reviews</b></p>
    <div class="row">
    <% for(review of listing.reviews) { %>
      <div class="card col-5 ms-3 mb-3">
        <div class="card-body">
          <h5 class="card-title"><b>Random Name (For Now)</b></h5>
          <p class="card-text"> <%= review.comment %> </p>
          <p class="card-text"> <%= review.rating %> out of 5 stars </p>
        </div>
        <form method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE" class="mt-3 mb-3">
          <button class="btn btn-dark">Delete Review</button>
        </form>
      </div> 
    <% } %>
    </div>
  </div>
</body>

