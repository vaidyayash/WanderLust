<% layout("/layouts/boilerPlate") %>
<body>
  <div class="row mt-3">
    <div class="col-8 offset-2">
      <h3><%= listing.title %></h3>

      <div class="card listing-card col-6">
        <img
          src="<%=listing.image.url%>"
          class="card-img-top show-img"
          alt="listing_image"
        />
        <div class="card-body">
          <br>
          <p> Owned by <b><i><%= listing.owner.username %></i></b></p>
          <p class="description fs-6"><%= listing.description %></p>
          <p class="fs-6">
            <b>&#163;<%= Number(listing.price).toLocaleString("en-GB") %></b>
          </p>
          <p class="fs-6">
            <b><%= listing.location %>, &nbsp;<%= listing.country %></b>
          </p>
        </div>
      </div>
    </div>
  <% if(currUser && listing.owner._id.equals(currUser._id)) { %>  
  </div>  <div class="btns offset-2">
    <div class="col-2 mb-4">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark"
        >Edit Listing</a
      >
    </div>
    <div class="col-2 mb-4">
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark">Delete Listing</button>
      </form>
    </div>
  </div>
  <% } %>

  
  <div class="col-8 offset-2 mt-4 mb-4 review">
    <% if(currUser) { %>
    <h4>Leave a Review</h4>
    <form method="POST" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
      <div>
      <label class="form-label" for="rating">Rating</label>
      <fieldset class="starability-basic">    
        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked       aria-label="No rating." />
        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
        <label for="first-rate1" title="Terrible">1 star</label>
        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
        <label for="first-rate2" title="Not good">2 stars</label>
        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
        <label for="first-rate3" title="Average">3 stars</label>
        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
        <label for="first-rate4" title="Very good">4 stars</label>
        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
        <label for="first-rate5" title="Amazing">5 stars</label>
      </fieldset>
      </div>
      <div>
        <label class="form-label" for="comment">Comment</label>
        <br>
        <textarea class="form-control" id="comment" name="review[comment]" maxlength="200"></textarea>
      </div>
      <br>
      <button class="btn btn-dark">Submit</button>
    </form>
    <% } %>
  </div>
  <div class="reviews col-8 offset-2">
    <hr>
    <p><b>All Reviews</b></p>
    <div class="row">
    <% for(review of listing.reviews) { %>
      <div class="card col-5 ms-3 mb-3">
        <div class="card-body">
          <h5 class="card-title"><b><%= review.author.username %></b></h5>
          <p class="starability-result card-text" data-rating="<%=review.rating%>"></p>
          <p class="card-text"> <%= review.comment %> </p>
        </div>
        <form method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE" class="mt-3 mb-3">
          <button class="btn btn-dark">Delete Review</button>
        </form>
      </div> 
    <% } %>
    </div>
  </div>
</body>

