<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WanderLust</title>
</head>
<body>
  <h3>All Listings</h3>
  <form method="GET" action="/listings/new">
    <button>Create New Listing</button>
  </form>
  <ul>
    <% for(let listing of listings) { %>
      <a href="/listings/<%=listing._id%>"> <%= listing.title %> </a>
      <br>
      <form method="GET" action="listings/<%=listing._id%>/edit"><button>Edit</button></form>
      <form method="POST" action="listings/<%=listing._id%>?_method=DELETE"><button>Delete</button></form>
      <br>
    <% } %> 
  </ul>
</body>
</html>